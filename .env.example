# OM Events — build-time configuration
#
# These are the ONLY values the Flutter web bundle needs. Pass them at build/run time:
#
#   fvm flutter build web --release \
#     --dart-define-from-file=.env.production.json
#
# or individually:
#
#   fvm flutter run -d chrome \
#     --dart-define=FIREBASE_PROJECT_ID=om-events-prod \
#     --dart-define=SUPABASE_URL=https://xxxx.supabase.co \
#     --dart-define=SUPABASE_ANON_KEY=eyJ...
#
# Copy to `.env.production.json` (gitignored) or a CI secret file. Never commit real values.

# ── Firebase (public client identifiers — NOT secrets) ─────────────────────────
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_MEASUREMENT_ID=

# ── Supabase Storage (product images, banners, media) ──────────────────────────
SUPABASE_URL=
# Supabase's "publishable" key (sb_pub_...). Older projects call it the anon key — same value,
# same role: public client credential.
SUPABASE_ANON_KEY=
SUPABASE_MEDIA_BUCKET=om-events-media

# ── Server ─────────────────────────────────────────────────────────────────────
FUNCTIONS_REGION=us-central1
SITE_URL=https://your-domain.example
CURRENCY=INR

# ── NEVER pass these to a Flutter build ────────────────────────────────────────
# They belong in Firebase Functions environment config (functions/.env, gitignored) and are
# refused by Env.hasServiceRoleKeyInClient if they ever reach the bundle.
# SUPABASE_SERVICE_ROLE_KEY=
# FIREBASE_SERVICE_ACCOUNT_JSON=
# RAZORPAY_KEY_SECRET=
# GATEWAY_WEBHOOK_SECRET=
